# ───────────────────────────────────────────────────────────────
#  Frontend — Node / Vite
# ───────────────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local
.vite/

# Vite build output copied into Spring's static resources.
# This is generated — never commit it.
backend/src/main/resources/static/

# ───────────────────────────────────────────────────────────────
#  Backend — Java / Maven / Gradle
# ───────────────────────────────────────────────────────────────
target/
build/
!**/src/main/**/target/
!**/src/test/**/target/

.gradle/
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

*.class
*.jar
*.war
*.ear
!.mvn/wrapper/maven-wrapper.jar
!gradle/wrapper/gradle-wrapper.jar

# ───────────────────────────────────────────────────────────────
#  Secrets & local config
# ───────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
application-local.yml
application-local.properties
*.pem
*.key

# ───────────────────────────────────────────────────────────────
#  Logs
# ───────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ───────────────────────────────────────────────────────────────
#  IDEs
# ───────────────────────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.classpath
.project
.settings/
nbproject/private/

# ───────────────────────────────────────────────────────────────
#  OS cruft
# ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
